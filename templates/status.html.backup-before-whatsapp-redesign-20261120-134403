<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Nexa | Status</title>

<style>
* {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: #f7f5fa;
    color: #292333;
}

header {
    background: white;
    padding: 18px 7%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    box-shadow: 0 2px 10px #00000010;
}

.logo {
    color: #642da0;
    font-size: 26px;
    font-weight: bold;
}

header a,
.back-link {
    color: #642da0;
    text-decoration: none;
    font-weight: bold;
}

main {
    max-width: 1000px;
    margin: 30px auto;
    padding: 20px;
}

h1,
h2,
h3 {
    color: #642da0;
}

.upload-box {
    background: white;
    padding: 25px;
    border-radius: 12px;
    box-shadow: 0 3px 12px #00000008;
    margin-bottom: 30px;
}

.upload-box input[type="file"] {
    display: block;
    width: 100%;
    margin: 18px 0;
    padding: 12px;
    border: 1px solid #ddd;
    border-radius: 7px;
}

button,
.upload-button {
    background: #642da0;
    color: white;
    border: none;
    padding: 12px 20px;
    border-radius: 7px;
    font-weight: bold;
    cursor: pointer;
}

button:hover,
.upload-button:hover {
    background: #4f2180;
}

.notice {
    color: #666;
    font-size: 14px;
    line-height: 1.6;
}

.flash {
    padding: 14px;
    margin-bottom: 15px;
    border-radius: 7px;
}

.flash.success {
    background: #e5f7e9;
    color: #216b32;
}

.flash.error {
    background: #ffe8e8;
    color: #9a2929;
}

.member-section {
    background: white;
    padding: 22px;
    border-radius: 12px;
    margin-bottom: 25px;
    box-shadow: 0 3px 12px #00000008;
}

.member-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
}

.member-heading h3 {
    margin-top: 0;
}

.status-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 18px;
    margin-top: 18px;
}

.status-item {
    border: 1px solid #eee;
    border-radius: 10px;
    padding: 12px;
    overflow: hidden;
}

.status-media {
    width: 100%;
    max-height: 380px;
    object-fit: contain;
    background: #17121d;
    border-radius: 8px;
    display: block;
}

.status-info {
    font-size: 13px;
    color: #777;
    margin: 12px 0;
}

.delete-form {
    margin-top: 10px;
}

.delete-button {
    background: #b52e3b;
    padding: 9px 14px;
    font-size: 13px;
}

.delete-button:hover {
    background: #8e202b;
}

.empty-state {
    background: white;
    padding: 30px;
    text-align: center;
    border-radius: 12px;
    color: #777;
}

@media (max-width: 600px) {
    main {
        padding: 14px;
        margin-top: 15px;
    }

    .upload-box,
    .member-section {
        padding: 17px;
    }

    .status-grid {
        grid-template-columns: 1fr;
    }
}
</style>
</head>

<body>

<header>
    <div class="logo">Nexa</div>
    <a href="{{ url_for('dashboard') }}">Dashboard</a>
</header>

<main>

    <h1>Nexa Status</h1>

    <p>
        Share moments with other verified Nexa members.
        Your Status disappears automatically after 24 hours.
    </p>

    <section class="upload-box">

        <h2>Upload a Status</h2>

        <form
            action="{{ url_for('upload_status') }}"
            method="POST"
            enctype="multipart/form-data"
        >

            <label for="media_files">
                Select pictures or videos
            </label>

            <input
                type="file"
                id="media_files"
                name="media_files"
                accept="image/jpeg,image/png,image/webp,video/*"
                multiple
                required
            >

            <p class="notice">
                Pictures: JPEG, PNG or WEBP.<br>
                Videos: maximum 12 seconds.<br>
                Each file must be 25 MB or smaller.<br>
                You can select multiple files at once.
            </p>

            <button type="submit">
                Upload Status
            </button>

        </form>

    </section>

    {% with messages = get_flashed_messages(with_categories=true) %}
        {% if messages %}
            {% for category, message in messages %}
                <div class="flash {{ category }}">
                    {{ message }}
                </div>
            {% endfor %}
        {% endif %}
    {% endwith %}

    <h2>Recent Status Updates</h2>

    {% if status_groups %}

        {% for group in status_groups %}

            <section class="member-section">

                <div class="member-heading">
                    <h3>{{ group.member.full_name }}</h3>

                    {% if group.member.id == user.id %}
                        <strong>Your Status</strong>
                    {% endif %}
                </div>

                <div class="status-grid">

                    {% for status in group.statuses %}

                        <article class="status-item">

                            {% if status.media_type == "image" %}

                                <img
                                    class="status-media"
                                    src="{{ url_for('view_status_media', status_id=status.id) }}"
                                    alt="Status picture"
                                    loading="lazy"
                                >

                            {% elif status.media_type == "video" %}

                                <video
                                    class="status-media"
                                    controls
                                    playsinline
                                    preload="metadata"
                                >
                                    <source
                                        src="{{ url_for('view_status_media', status_id=status.id) }}"
                                    >
                                    Your browser does not support video playback.
                                </video>

                            {% endif %}

                            <div class="status-info">
                                <p>
                                    Uploaded:
                                    {{ status.uploaded_at.strftime('%d %b %Y, %I:%M %p') }}
                                </p>

                                <p>
                                    Expires:
                                    {{ status.expires_at.strftime('%d %b %Y, %I:%M %p') }}
                                </p>

                                {% if status.media_type == "video" %}
                                    <p>
                                        Video duration:
                                        {{ "%.1f"|format(status.duration_seconds) }}
                                        seconds
                                    </p>
                                {% endif %}
                            </div>

                            {% if status.user_id == user.id %}

                                <form
                                    class="delete-form"
                                    action="{{ url_for('delete_status', status_id=status.id) }}"
                                    method="POST"
                                    onsubmit="return confirm('Are you sure you want to delete this Status?');"
                                >
                                    <button
                                        type="submit"
                                        class="delete-button"
                                    >
                                        Delete Status
                                    </button>
                                </form>

                            {% endif %}

                        </article>

                    {% endfor %}

                </div>

            </section>

        {% endfor %}

    {% else %}

        <div class="empty-state">
            <h3>No active Status updates</h3>
            <p>Be the first to share a picture or video.</p>
        </div>

    {% endif %}

    <p>
        <a class="back-link" href="{{ url_for('dashboard') }}">
            Back to Dashboard
        </a>
    </p>

</main>

</body>
</html>
