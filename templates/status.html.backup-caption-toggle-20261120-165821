<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Nexa | Status</title>

<style>
* { box-sizing: border-box; }

body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: #f7f5fa;
    color: #292333;
}

header {
    background: white;
    padding: 15px 6%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    box-shadow: 0 2px 10px #00000010;
}

.logo {
    color: #642da0;
    font-size: 26px;
    font-weight: bold;
}

header a {
    color: #642da0;
    text-decoration: none;
    font-weight: bold;
}

main {
    max-width: 950px;
    margin: 25px auto;
    padding: 15px;
}

h1, h2, h3 { color: #642da0; }

.status-panel {
    background: white;
    padding: 22px;
    border-radius: 15px;
    box-shadow: 0 3px 15px #00000008;
}

.panel-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
}

.panel-heading h2 { margin: 0; }

.status-row {
    display: flex;
    gap: 22px;
    overflow-x: auto;
    padding: 22px 3px 12px;
}

.status-person {
    flex: 0 0 90px;
    width: 90px;
    text-align: center;
    cursor: pointer;
    border: 0;
    background: transparent;
    color: #292333;
    padding: 0;
    font: inherit;
}

.avatar-ring {
    width: 76px;
    height: 76px;
    padding: 3px;
    border-radius: 50%;
    margin: 0 auto 8px;
    background: conic-gradient(#642da0, #a66cdb, #642da0);
}

.avatar-ring.no-status {
    background: #d9c9e8;
    border: 2px dashed #8d65b2;
    padding: 2px;
}

.avatar-inner {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: #eee5f6;
    border: 3px solid white;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    color: #642da0;
    font-size: 25px;
    font-weight: bold;
}

.avatar-inner img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.person-name {
    display: block;
    font-size: 13px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.add-status {
    position: relative;
}

.plus {
    position: absolute;
    right: 1px;
    bottom: 25px;
    width: 27px;
    height: 27px;
    border-radius: 50%;
    background: #642da0;
    color: white;
    border: 2px solid white;
    font-size: 21px;
    line-height: 22px;
}

.upload-panel {
    display: none;
    margin-top: 20px;
    padding: 20px;
    border: 1px solid #e8def1;
    border-radius: 12px;
    background: #fcfaff;
}

.upload-panel.open { display: block; }

.upload-panel input[type="file"] {
    display: block;
    width: 100%;
    margin: 15px 0;
    padding: 12px;
    border: 1px solid #ddd;
    border-radius: 8px;
    background: white;
}

button, .button {
    background: #642da0;
    color: white;
    border: 0;
    padding: 11px 18px;
    border-radius: 8px;
    font-weight: bold;
    cursor: pointer;
}

button:hover, .button:hover { background: #4f2180; }

.secondary-button {
    background: #eee5f6;
    color: #642da0;
}

.secondary-button:hover {
    background: #e2d2f0;
}

.upload-panel textarea,
.upload-panel select {
    display: block;
    width: 100%;
    margin: 8px 0 16px;
    padding: 12px;
    border: 1px solid #ddd;
    border-radius: 8px;
    background: white;
    color: #292333;
    font: inherit;
}

.upload-panel textarea {
    resize: vertical;
}

.add-status-action {
    margin-left: 10px;
    padding: 8px 13px;
    font-size: 13px;
}

.status-text-card {
    width: min(680px, 90%);
    max-height: 75%;
    overflow-wrap: anywhere;
    overflow-y: auto;
    padding: 28px;
    color: white;
    text-align: center;
    font-size: clamp(24px, 5vw, 42px);
    font-weight: bold;
    line-height: 1.45;
    white-space: pre-wrap;
    z-index: 1;
}

.status-caption {
    position: absolute;
    left: 5%;
    right: 5%;
    bottom: 18px;
    z-index: 1;
    padding: 12px 16px;
    border-radius: 10px;
    background: #000000a8;
    color: white;
    text-align: center;
    font-size: 16px;
    line-height: 1.4;
    overflow-wrap: anywhere;
}

.notice {
    font-size: 13px;
    line-height: 1.6;
    color: #777;
}

.flash {
    padding: 13px;
    margin: 15px 0;
    border-radius: 8px;
}

.flash.success { background: #e5f7e9; color: #216b32; }
.flash.error { background: #ffe8e8; color: #9a2929; }

.empty-message {
    color: #777;
    text-align: center;
    padding: 25px 10px;
}

/* Full-screen Status viewer */

.viewer {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 1000;
    background: #17121d;
    color: white;
    flex-direction: column;
}

.viewer.open { display: flex; }

.viewer-top {
    padding: 14px 16px;
    z-index: 2;
}

.progress-list {
    display: flex;
    gap: 4px;
    width: 100%;
    margin-bottom: 15px;
}

.progress-track {
    height: 3px;
    flex: 1;
    border-radius: 5px;
    background: #ffffff55;
    overflow: hidden;
}

.progress-fill {
    width: 0%;
    height: 100%;
    background: white;
}

.viewer-member {
    display: flex;
    align-items: center;
    gap: 10px;
}

.viewer-avatar {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    object-fit: cover;
    background: #642da0;
}

.viewer-member-name {
    font-weight: bold;
}

.viewer-time {
    font-size: 12px;
    color: #ddd;
    margin-top: 4px;
}

.viewer-close {
    margin-left: auto;
    background: transparent;
    color: white;
    font-size: 27px;
    padding: 3px 10px;
}

.viewer-content {
    flex: 1;
    min-height: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
}

.viewer-content img,
.viewer-content video {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
}

.viewer-content video { width: 100%; height: 100%; }

.viewer-tap-left,
.viewer-tap-right {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 35%;
    z-index: 2;
}

.viewer-tap-left { left: 0; }
.viewer-tap-right { right: 0; }

.viewer-bottom {
    min-height: 65px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 12px;
}

.delete-status-button {
    background: #b52e3b;
}

.viewer-counter {
    color: #ddd;
    font-size: 13px;
}

@media (max-width: 600px) {
    main { margin: 10px auto; padding: 10px; }
    .status-panel { padding: 16px; }
    .status-row { gap: 17px; }
    .viewer-content img { max-width: 100%; }
}
</style>
</head>

<body>

<header>
    <div class="logo">Nexa</div>
    <a href="{{ url_for('dashboard') }}">Dashboard</a>
</header>

<main>

    <section class="status-panel">

        <div class="panel-heading">
            <h2>Status Updates</h2>
            <div>
                <span class="notice">Updates disappear after 24 hours</span>
                <button type="button" id="openUploadButton" class="add-status-action">Add Status</button>
            </div>
        </div>

        {% with messages = get_flashed_messages(with_categories=true) %}
            {% if messages %}
                {% for category, message in messages %}
                    <div class="flash {{ category }}">{{ message }}</div>
                {% endfor %}
            {% endif %}
        {% endwith %}

        <div class="status-row">

            {% for group in status_groups %}

                {% if group.member.id == user.id %}

                    <button
                        type="button"
                        class="status-person add-status"
                        id="myStatusButton"
                    >
                        <div class="avatar-ring {% if not group.statuses %}no-status{% endif %}">
                            <div class="avatar-inner">
                                {% if user.profile_photo %}
                                    <img
                                        src="{{ url_for('static', filename='uploads/' ~ user.profile_photo) }}"
                                        alt="Your profile picture"
                                    >
                                {% else %}
                                    {{ user.full_name[0]|upper }}
                                {% endif %}
                            </div>
                        </div>

                        <span class="plus">+</span>
                        <span class="person-name">My Status</span>
                    </button>

                {% elif group.statuses %}

                    <button
                        type="button"
                        class="status-person"
                        data-open-group="{{ loop.index0 }}"
                    >
                        <div class="avatar-ring">
                            <div class="avatar-inner">
                                {% if group.member.profile_photo %}
                                    <img
                                        src="{{ url_for('static', filename='uploads/' ~ group.member.profile_photo) }}"
                                        alt="{{ group.member.full_name }}"
                                    >
                                {% else %}
                                    {{ group.member.full_name[0]|upper }}
                                {% endif %}
                            </div>
                        </div>

                        <span class="person-name">
                            {{ group.member.full_name }}
                        </span>
                    </button>

                {% endif %}

            {% endfor %}

        </div>

        {% if status_groups|length <= 1 %}
            <div class="empty-message">
                No other active Status updates yet. Share yours first.
            </div>
        {% endif %}

        <div class="upload-panel" id="uploadPanel">

            <h3>Add to My Status</h3>

            <form
                action="{{ url_for('upload_status') }}"
                method="POST"
                enctype="multipart/form-data"
            >

                <label for="text_content">Write a text Status</label>
                <textarea
                    id="text_content"
                    name="text_content"
                    maxlength="1000"
                    rows="4"
                    placeholder="What would you like to share?"
                ></textarea>

                <label for="background_color">Text Status background</label>
                <select id="background_color" name="background_color">
                    <option value="#5631A8">Nexa Purple</option>
                    <option value="#7B2CBF">Violet</option>
                    <option value="#C2185B">Pink</option>
                    <option value="#D35400">Orange</option>
                    <option value="#167D63">Green</option>
                    <option value="#2457A7">Blue</option>
                    <option value="#202124">Dark</option>
                    <option value="#8A6D1D">Gold</option>
                </select>

                <label for="caption">Picture or video caption (optional)</label>
                <textarea
                    id="caption"
                    name="caption"
                    maxlength="500"
                    rows="2"
                    placeholder="Add a caption to your pictures or videos"
                ></textarea>

                <label for="media_files">Choose pictures or videos (optional)</label>
                <input
                    type="file"
                    id="media_files"
                    name="media_files"
                    accept="image/jpeg,image/png,image/webp,video/*"
                    multiple
                >

                <p class="notice">
                    Write a message, select media, or do both.<br>
                    Pictures: JPEG, PNG or WEBP.<br>
                    Videos: maximum 12 seconds.<br>
                    Maximum file size: 25 MB each. You can select multiple files.
                </p>

                <button type="submit">Share Status</button>
                <button type="button" class="secondary-button" id="cancelUpload">
                    Cancel
                </button>

            </form>

        </div>

    </section>

</main>

<!-- Full-screen Status viewer -->

<div class="viewer" id="statusViewer">

    <div class="viewer-top">

        <div class="progress-list" id="progressList"></div>

        <div class="viewer-member">
            <img class="viewer-avatar" id="viewerAvatar" alt="">
            <div>
                <div class="viewer-member-name" id="viewerName"></div>
                <div class="viewer-time" id="viewerTime"></div>
            </div>

            <button class="viewer-close" id="closeViewer" aria-label="Close">
                &times;
            </button>
        </div>

    </div>

    <div class="viewer-content" id="viewerContent">
        <div class="viewer-tap-left" id="previousStatus"></div>
        <div class="viewer-tap-right" id="nextStatus"></div>
    </div>

    <div class="viewer-bottom">
        <span class="viewer-counter" id="viewerCounter"></span>

        <form id="deleteStatusForm" method="POST" style="display:none;">
            <button type="submit" class="delete-status-button"
                onclick="return confirm('Delete this Status?');">
                Delete my Status
            </button>
        </form>
    </div>

</div>

<script>
const statusGroups = [
    {% for group in status_groups %}
    {
        memberId: {{ group.member.id|tojson }},
        name: {{ group.member.full_name|tojson }},
        isMine: {{ (group.member.id == user.id)|tojson }},
        photo: {% if group.member.profile_photo %}
            {{ url_for('static', filename='uploads/' ~ group.member.profile_photo)|tojson }}
        {% else %}
            ""
        {% endif %},
        statuses: [
            {% for status in group.statuses %}
            {
                id: {{ status.id|tojson }},
                type: {{ status.media_type|tojson }},
                url: {{ url_for('view_status_media', status_id=status.id)|tojson }},
                text: {{ status.text_content|tojson }},
                caption: {{ status.caption|tojson }},
                backgroundColor: {{ status.background_color|tojson }},
                duration: {{ status.duration_seconds|tojson }},
                uploaded: {{ status.uploaded_at.strftime('%d %b %Y, %I:%M %p')|tojson }},
                deleteUrl: {{ url_for('delete_status', status_id=status.id)|tojson }}
            }{% if not loop.last %},{% endif %}
            {% endfor %}
        ]
    }{% if not loop.last %},{% endif %}
    {% endfor %}
];

const viewer = document.getElementById("statusViewer");
const viewerContent = document.getElementById("viewerContent");
const progressList = document.getElementById("progressList");
const viewerName = document.getElementById("viewerName");
const viewerAvatar = document.getElementById("viewerAvatar");
const viewerTime = document.getElementById("viewerTime");
const viewerCounter = document.getElementById("viewerCounter");
const deleteForm = document.getElementById("deleteStatusForm");

let activeGroup = 0;
let activeStatus = 0;
let progressTimer = null;
let startedAt = 0;
let elapsedBeforePause = 0;
let totalDuration = 5000;
let paused = false;
let currentMedia = null;

function clearPlayback() {
    if (progressTimer) {
        clearInterval(progressTimer);
        progressTimer = null;
    }

    if (currentMedia && currentMedia.tagName === "VIDEO") {
        currentMedia.pause();
        currentMedia.removeAttribute("src");
        currentMedia.load();
    }

    currentMedia = null;
}

function openGroup(groupIndex) {
    const group = statusGroups[groupIndex];

    if (!group || !group.statuses.length) return;

    activeGroup = groupIndex;
    activeStatus = 0;
    viewer.classList.add("open");
    document.body.style.overflow = "hidden";

    viewerName.textContent = group.name;
    viewerAvatar.src = group.photo || "";
    viewerAvatar.style.visibility = group.photo ? "visible" : "hidden";

    showStatus();
}

function showStatus() {
    clearPlayback();

    const group = statusGroups[activeGroup];
    const status = group.statuses[activeStatus];

    if (!status) {
        closeViewer();
        return;
    }

    viewerTime.textContent = status.uploaded;
    viewerCounter.textContent =
        (activeStatus + 1) + " / " + group.statuses.length;

    progressList.innerHTML = "";

    group.statuses.forEach((item, index) => {
        const track = document.createElement("div");
        track.className = "progress-track";

        const fill = document.createElement("div");
        fill.className = "progress-fill";

        if (index < activeStatus) fill.style.width = "100%";

        track.appendChild(fill);
        progressList.appendChild(track);
    });

    const activeFill = progressList.children[activeStatus].firstChild;

    viewerContent.querySelectorAll(
        "img, video, .status-text-card, .status-caption"
    ).forEach(el => el.remove());

    currentMedia = null;

    viewerContent.style.backgroundColor = status.type === "text"
        ? (status.backgroundColor || "#5631A8")
        : "#17121d";

    if (status.type === "text") {
        const textCard = document.createElement("div");
        textCard.className = "status-text-card";
        textCard.textContent = status.text || "";

        viewerContent.insertBefore(
            textCard,
            document.getElementById("previousStatus")
        );

        totalDuration = 7000;
        startProgress(activeFill);

    } else if (status.type === "image") {
        currentMedia = document.createElement("img");
        currentMedia.src = status.url;
        currentMedia.alt = "Nexa Status picture";

        totalDuration = 5000;
        startProgress(activeFill);

    } else {
        currentMedia = document.createElement("video");
        currentMedia.src = status.url;
        currentMedia.autoplay = true;
        currentMedia.playsInline = true;
        currentMedia.preload = "auto";
        currentMedia.controls = false;

        currentMedia.addEventListener("loadedmetadata", () => {
            totalDuration = Math.min(
                currentMedia.duration * 1000,
                12000
            );
            startProgress(activeFill);
        }, { once: true });

        currentMedia.addEventListener("ended", nextStatus, { once: true });

        currentMedia.addEventListener("error", () => {
            nextStatus();
        }, { once: true });
    }

    if (currentMedia) {
        viewerContent.insertBefore(
            currentMedia,
            document.getElementById("previousStatus")
        );
    }

    if (status.type !== "text" && status.caption) {
        const captionElement = document.createElement("div");
        captionElement.className = "status-caption";
        captionElement.textContent = status.caption;

        viewerContent.insertBefore(
            captionElement,
            document.getElementById("previousStatus")
        );
    }

    deleteForm.style.display = group.isMine ? "block" : "none";
    deleteForm.action = status.deleteUrl || "";
}

function startProgress(fill) {
    if (progressTimer) clearInterval(progressTimer);

    paused = false;
    elapsedBeforePause = 0;
    startedAt = Date.now();

    progressTimer = setInterval(() => {
        if (paused) return;

        const elapsed = elapsedBeforePause + (Date.now() - startedAt);
        const percentage = Math.min((elapsed / totalDuration) * 100, 100);

        fill.style.width = percentage + "%";

        if (elapsed >= totalDuration) {
            if (currentMedia && currentMedia.tagName === "VIDEO") {
                if (currentMedia.ended) nextStatus();
            } else {
                nextStatus();
            }
        }
    }, 50);
}

function pauseStatus() {
    if (paused) return;

    paused = true;
    elapsedBeforePause += Date.now() - startedAt;

    if (currentMedia && currentMedia.tagName === "VIDEO") {
        currentMedia.pause();
    }
}

function resumeStatus() {
    if (!paused) return;

    paused = false;
    startedAt = Date.now();

    if (currentMedia && currentMedia.tagName === "VIDEO") {
        currentMedia.play().catch(() => {});
    }
}

function nextStatus() {
    const group = statusGroups[activeGroup];

    if (activeStatus < group.statuses.length - 1) {
        activeStatus++;
        showStatus();
    } else {
        closeViewer();
    }
}

function previousStatus() {
    if (activeStatus > 0) {
        activeStatus--;
        showStatus();
    }
}

function closeViewer() {
    clearPlayback();
    viewer.classList.remove("open");
    document.body.style.overflow = "";
}

document.getElementById("openUploadButton").addEventListener("click", () => {
    document.getElementById("uploadPanel").classList.add("open");
});

document.getElementById("myStatusButton").addEventListener("click", () => {
    const ownGroup = statusGroups.findIndex(group => group.isMine);

    if (ownGroup >= 0 && statusGroups[ownGroup].statuses.length) {
        openGroup(ownGroup);
    } else {
        document.getElementById("uploadPanel").classList.toggle("open");
    }
});

document.getElementById("cancelUpload").addEventListener("click", () => {
    document.getElementById("uploadPanel").classList.remove("open");
});

document.querySelectorAll("[data-open-group]").forEach(button => {
    button.addEventListener("click", () => {
        openGroup(Number(button.dataset.openGroup));
    });
});

document.getElementById("closeViewer").addEventListener("click", closeViewer);
document.getElementById("nextStatus").addEventListener("click", nextStatus);
document.getElementById("previousStatus").addEventListener("click", previousStatus);

viewerContent.addEventListener("pointerdown", pauseStatus);
viewerContent.addEventListener("pointerup", resumeStatus);
viewerContent.addEventListener("pointerleave", resumeStatus);

document.addEventListener("keydown", event => {
    if (!viewer.classList.contains("open")) return;

    if (event.key === "Escape") closeViewer();
    if (event.key === "ArrowRight") nextStatus();
    if (event.key === "ArrowLeft") previousStatus();
});

</script>

</body>
</html>
