                "ALTER TABLE user "
                "ADD COLUMN email_verified_at DATETIME"
            ),

            "gender": (
                "ALTER TABLE user "
                "ADD COLUMN gender VARCHAR(30) DEFAULT ''"
            ),

            "location": (
                "ALTER TABLE user "
                "ADD COLUMN location VARCHAR(150) DEFAULT ''"
            ),

            "bio": (
                "ALTER TABLE user "
                "ADD COLUMN bio TEXT DEFAULT ''"
            ),

            "interests": (
