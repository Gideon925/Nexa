def get_membership_status(user):
    """Return the member's current trial or paid subscription status."""
    now = datetime.utcnow()

    subscription = Subscription.query.filter_by(user_id=user.id).first()

    if (
        subscription
        and subscription.status == "active"
        and subscription.current_period_end
        and subscription.current_period_end > now
    ):
        expiry = subscription.current_period_end
        membership_type = "paid"
    elif user.trial_ends_at and user.trial_ends_at > now:
        expiry = user.trial_ends_at
        membership_type = "trial"
    else:
        return {
            "active": False,
            "type": "expired",
            "expires_at": None,
            "days_remaining": 0
        }

    seconds_remaining = (expiry - now).total_seconds()

    return {
        "active": True,
        "type": membership_type,
        "expires_at": expiry,
        "days_remaining": int((seconds_remaining + 86399) // 86400)
    }


def subscription_required(function):
    @wraps(function)
    def wrapper(*args, **kwargs):
        user = get_current_user()

        if user is None:
            session.clear()
            return redirect(url_for("login"))

        if not get_membership_status(user)["active"]:
            flash(
                "Your free trial or subscription has expired. "
                "Please choose a membership plan to continue.",
                "warning"
            )
            return redirect(url_for("subscription"))

        return function(*args, **kwargs)

    return wrapper


def add_months(original_date, months):
    """Add calendar months without losing valid end-of-month dates."""

    month_index = original_date.month - 1 + months
    year = original_date.year + month_index // 12
    month = month_index % 12 + 1

    day = min(
        original_date.day,
        calendar.monthrange(year, month)[1]
    )

    return original_date.replace(
        year=year,
        month=month,
        day=day
    )


# --------------------------------------------------
# PAYSTACK PAYMENT VERIFICATION
# --------------------------------------------------

def verify_and_complete_payment(reference):
    """
    Verify a transaction directly with Paystack.
    Activate a subscription only after the exact payment
    amount, currency, reference and status are confirmed.
    """

    if not PAYSTACK_SECRET_KEY:
        raise ValueError("Paystack secret key is not configured.")

    payment = Payment.query.filter_by(reference=reference).first()

    if payment is None:
        raise ValueError("Payment reference was not found.")

    # Prevent duplicate subscription activation.
    if payment.status == "success":
        return payment

    response = requests.get(
        f"{PAYSTACK_BASE_URL}/transaction/verify/{reference}",
        headers={
            "Authorization": f"Bearer {PAYSTACK_SECRET_KEY}",
            "Content-Type": "application/json"
        },
        timeout=30
    )

    response.raise_for_status()
    result = response.json()

    if not result.get("status"):
        raise ValueError("Paystack could not verify this payment.")

    transaction = result.get("data", {})

    if transaction.get("status") != "success":
        raise ValueError("The payment has not been completed.")

    if transaction.get("reference") != payment.reference:
        raise ValueError("Payment reference does not match.")

    if transaction.get("amount") != payment.amount_kobo:
        raise ValueError("Payment amount does not match.")

    if transaction.get("currency") != "NGN":
        raise ValueError("Payment currency is not supported.")

    if payment.purpose == "contact_unlock":
        owner = db.session.get(User, payment.target_user_id)

        if owner is None or owner.id == payment.user_id:
            raise ValueError("Invalid contact unlock account.")

        if not owner.contact_sharing_enabled or not owner.phone:
            raise ValueError("This member is not sharing their phone number.")

        existing_unlock = ContactUnlock.query.filter_by(
            buyer_id=payment.user_id,
            profile_owner_id=owner.id
        ).first()

        now = datetime.utcnow()
        expires = now + timedelta(minutes=5)

        if existing_unlock is None:
            existing_unlock = ContactUnlock(
                buyer_id=payment.user_id,
                profile_owner_id=owner.id,
                payment_id=payment.id,
                created_at=now,
                expires_at=expires
            )
            db.session.add(existing_unlock)
        else:
            existing_unlock.payment_id = payment.id
            existing_unlock.created_at = now
            existing_unlock.expires_at = expires

        payment.status = "success"
        payment.provider_transaction_id = str(transaction.get("id", ""))
        payment.paid_at = now

        db.session.commit()
        return payment

    if payment.purpose not in (
        "subscription_1_month",
        "subscription_5_months",
        "subscription_6_months",
        "subscription_12_months"
    ):
        raise ValueError("This payment purpose is not supported yet.")

    user = db.session.get(User, payment.user_id)

    if user is None:
        raise ValueError("The account for this payment was not found.")

    months_by_purpose = {
        "subscription_1_month": 1,
        "subscription_5_months": 5,
        "subscription_6_months": 6,
        "subscription_12_months": 12
    }

    months = months_by_purpose[payment.purpose]

    now = datetime.utcnow()

    subscription = Subscription.query.filter_by(
        user_id=user.id
    ).first()

    if subscription is None:
        subscription = Subscription(
            user_id=user.id,
            status="active",
            current_period_start=now,
            current_period_end=add_months(now, months)
        )

        db.session.add(subscription)

    else:
        old_end = subscription.current_period_end

        if (
            subscription.status == "active"
            and old_end
            and old_end > now
        ):
            start_date = old_end
        else:
            start_date = now

        subscription.status = "active"

        if subscription.current_period_start is None:
            subscription.current_period_start = now

        subscription.current_period_end = add_months(
            start_date,
            months
        )

    payment.status = "success"
    payment.provider_transaction_id = str(transaction.get("id", ""))
    payment.paid_at = now

    db.session.commit()

    return payment


