@app.route("/discover")
@login_required
@profile_complete_required
def discover():
    current_user = get_current_user()

    if current_user is None:
        session.clear()
        return redirect(url_for("login"))

    search = request.args.get("q", "").strip()
    gender_filter = request.args.get("gender", "").strip()
    preference_filter = request.args.get("preference", "").strip()
    location_filter = request.args.get("location", "").strip()

    allowed_genders = ["Male", "Female", "Other"]
    allowed_preferences = [
        "Dating",
        "Friendship",
        "Friends with benefits",
        "Casual connections",
        "Serious relationship"
    ]

    if gender_filter not in allowed_genders:
        gender_filter = ""

    if preference_filter not in allowed_preferences:
        preference_filter = ""

    try:
        min_age = int(request.args.get("min_age", "18"))
        max_age = int(request.args.get("max_age", "100"))
    except (TypeError, ValueError):
        min_age, max_age = 18, 100

    min_age = max(18, min(min_age, 100))
    max_age = max(18, min(max_age, 100))

    if min_age > max_age:
        min_age, max_age = 18, 100

    members = User.query.filter(
        User.id != current_user.id
    ).order_by(User.created_at.desc()).all()

    today = date.today()
    member_cards = []

    for member in members:
        if not member.date_of_birth:
            continue

        age = today.year - member.date_of_birth.year - (
            (today.month, today.day) <
            (member.date_of_birth.month, member.date_of_birth.day)
        )

        if age < 18 or age < min_age or age > max_age:
            continue

        if gender_filter and member.gender != gender_filter:
            continue

        if preference_filter and member.connection_preference != preference_filter:
            continue

        if location_filter and location_filter.casefold() not in (
            (member.location or "").casefold()
        ):
            continue

        searchable_text = " ".join([
            member.full_name or "",
            member.location or "",
            member.interests or "",
            member.bio or ""
        ]).casefold()

        if search and search.casefold() not in searchable_text:
            continue

        member_cards.append({
            "user": member,
            "age": age
        })

    return render_template(
        "discover.html",
        user=current_user,
        members=member_cards,
        search=search,
        gender_filter=gender_filter,
        preference_filter=preference_filter,
        location_filter=location_filter,
        min_age=min_age,
        max_age=max_age
    )


@app.route("/member/<int:user_id>")
@login_required
@profile_complete_required
def member_profile(user_id):
    current_user = get_current_user()

    if current_user is None:
        session.clear()
        return redirect(url_for("login"))

    member = db.session.get(User, user_id)

    if member is None:
        flash("That member could not be found.", "error")
        return redirect(url_for("discover"))

    if not member.date_of_birth:
        flash("This member's profile is unavailable.", "error")
        return redirect(url_for("discover"))

    today = date.today()
    age = today.year - member.date_of_birth.year - (
        (today.month, today.day) <
        (member.date_of_birth.month, member.date_of_birth.day)
    )

    if age < 18:
        flash("This profile is unavailable.", "error")
        return redirect(url_for("discover"))

    is_blocked_by_me = MemberBlock.query.filter_by(
        blocker_id=current_user.id,
        blocked_id=member.id
    ).first() is not None

    is_blocked_by_member = MemberBlock.query.filter_by(
        blocker_id=member.id,
        blocked_id=current_user.id
    ).first() is not None

    if is_blocked_by_member:
        flash("You cannot view this member's profile.", "error")
        return redirect(url_for("discover"))

    connection_request = ConnectionRequest.query.filter(
        db.or_(
            db.and_(
                ConnectionRequest.sender_id == current_user.id,
                ConnectionRequest.receiver_id == member.id
            ),
            db.and_(
                ConnectionRequest.sender_id == member.id,
                ConnectionRequest.receiver_id == current_user.id
            )
        )
    ).first()

    connection_status = "none"
    request_direction = None

    if connection_request:
        connection_status = connection_request.status

        if connection_request.sender_id == current_user.id:
            request_direction = "sent"
        else:
            request_direction = "received"

    now = datetime.utcnow()

    active_contact_unlock = ContactUnlock.query.filter(
        ContactUnlock.buyer_id == current_user.id,
        ContactUnlock.profile_owner_id == member.id,
        ContactUnlock.expires_at > now
    ).first()

    return render_template(
        "member_profile.html",
        user=current_user,
        member=member,
        age=age,
        is_blocked_by_me=is_blocked_by_me,
        is_blocked_by_member=is_blocked_by_member,
        connection_status=connection_status,
        request_direction=request_direction,
        contact_unlocked=active_contact_unlock is not None,
        contact_unlock_expires_at=(
            active_contact_unlock.expires_at.isoformat()
            if active_contact_unlock else None
        )
    )


