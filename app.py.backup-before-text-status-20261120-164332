# --------------------------------------------------
# DATABASE CREATION AND SAFE MIGRATIONS
# --------------------------------------------------

with app.app_context():

    db.create_all()

    with db.engine.begin() as connection:

        columns = {
            row[1]
            for row in connection.execute(
                text("PRAGMA table_info(user)")
            ).fetchall()
        }

        migrations = {
            "password_reset_token_hash": (
                "ALTER TABLE user "
                "ADD COLUMN password_reset_token_hash VARCHAR(64)"
            ),

            "email_verified": (
                "ALTER TABLE user "
                "ADD COLUMN email_verified BOOLEAN NOT NULL DEFAULT 0"
            ),

            "email_verified_at": (
                "ALTER TABLE user "
                "ADD COLUMN email_verified_at DATETIME"
            ),

            "gender": (
                "ALTER TABLE user "
                "ADD COLUMN gender VARCHAR(30) DEFAULT ''"
            ),

            "location": (
                "ALTER TABLE user "
                "ADD COLUMN location VARCHAR(150) DEFAULT ''"
            ),

            "bio": (
                "ALTER TABLE user "
                "ADD COLUMN bio TEXT DEFAULT ''"
            ),

            "interests": (
                "ALTER TABLE user "
                "ADD COLUMN interests VARCHAR(500) DEFAULT ''"
            ),

            "connection_preference": (
                "ALTER TABLE user "
                "ADD COLUMN connection_preference VARCHAR(50) DEFAULT ''"
            ),

            "profile_photo": (
                "ALTER TABLE user "
                "ADD COLUMN profile_photo VARCHAR(255) DEFAULT ''"
            )
        }

        for column, sql in migrations.items():

            if column not in columns:
                connection.execute(text(sql))

        # Safely add media_type to an existing Status table.
        status_columns = {
            row[1]
            for row in connection.execute(
                text("PRAGMA table_info(status)")
            ).fetchall()
        }

        if "media_type" not in status_columns:
            connection.execute(
                text(
                    "ALTER TABLE status "
                    "ADD COLUMN media_type VARCHAR(10) "
                    "NOT NULL DEFAULT 'image'"
                )
            )


