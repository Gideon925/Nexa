@app.route("/payment/webhook", methods=["POST"])
def paystack_webhook():
    if not PAYSTACK_SECRET_KEY:
        abort(503)

    signature = request.headers.get(
        "x-paystack-signature", ""
    )

    raw_body = request.get_data()

    expected_signature = hmac.new(
        PAYSTACK_SECRET_KEY.encode("utf-8"),
        raw_body,
        hashlib.sha512
    ).hexdigest()

    if not hmac.compare_digest(
        signature,
        expected_signature
    ):
        abort(401)

    event = request.get_json(silent=True) or {}

    if event.get("event") == "charge.success":
        reference = (
            event.get("data", {}).get("reference", "")
        )

        if reference:
            try:
                verify_and_complete_payment(reference)

            except (requests.RequestException, ValueError):
                db.session.rollback()
                app.logger.exception(
                    "Paystack webhook payment verification failed."
                )
                return "Verification failed", 500

    return "OK", 200


# --------------------------------------------------
# SETTINGS
# --------------------------------------------------

@app.route("/settings", methods=["GET", "POST"])
@login_required
def settings():
    user = get_current_user()

    if user is None:
        session.clear()
        return redirect(url_for("login"))

    if request.method == "POST":
        action = request.form.get("action", "")

        if action == "update_account":
            full_name = request.form.get("full_name", "").strip()
            email = request.form.get("email", "").strip().lower()
            phone = request.form.get("phone", "").strip()

            if not full_name or not email or not phone:
                flash("Please complete all account fields.", "error")
                return redirect(url_for("settings"))

            existing_user = User.query.filter(
                User.email == email,
                User.id != user.id
            ).first()

            if existing_user:
                flash("That email address is already registered.", "error")
                return redirect(url_for("settings"))

            user.full_name = full_name
            user.email = email
            user.phone = phone

            db.session.commit()
            flash("Your account information has been updated.", "success")

        elif action == "change_password":
            current_password = request.form.get("current_password", "")
            new_password = request.form.get("new_password", "")
            confirm_password = request.form.get("confirm_password", "")

            if not user.check_password(current_password):
                flash("Your current password is incorrect.", "error")
                return redirect(url_for("settings"))

            if len(new_password) < 8:
                flash("Your new password must contain at least 8 characters.", "error")
                return redirect(url_for("settings"))

            if new_password != confirm_password:
                flash("The new passwords do not match.", "error")
                return redirect(url_for("settings"))

            user.set_password(new_password)
            db.session.commit()

            flash("Your password has been changed successfully.", "success")

        else:
            flash("Invalid settings request.", "error")

        return redirect(url_for("settings"))

    current_subscription = Subscription.query.filter_by(
        user_id=user.id
    ).first()

    return render_template(
        "settings.html",
        user=user,
        current_subscription=current_subscription
    )


